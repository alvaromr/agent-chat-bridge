#!/bin/sh
# Refuses to move or delete a tag the remote already has: a released version identifies one commit forever. Then runs
# the dependency audit, which needs the network the pre-commit hook does without. Installed by `pnpm bootstrap`. Git
# passes one line per ref: local ref, local sha, remote ref, remote sha.
set -e
zero=0000000000000000000000000000000000000000
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/tags/*)
            if [ "$remote_sha" != "$zero" ] && [ "$local_sha" != "$remote_sha" ]; then
                echo "pre-push: ${remote_ref#refs/tags/} is already on the remote; tags are never moved or deleted" >&2
                exit 1
            fi
            ;;
    esac
done
# `run`: pnpm's own audit command would shadow the script, which also audits the dictation worker's packages.
pnpm run audit
